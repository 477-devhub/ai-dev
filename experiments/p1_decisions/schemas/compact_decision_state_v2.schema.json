{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://477.local/experiments/compact_decision_state_v2.schema.json",
  "title": "477 Compact CV State v2",
  "description": "Observation evidence only. Missing samples are not absence; adjacent spans are not continuous duration. No routing or event judgments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "observation_window_sec",
    "cameras",
    "cross_camera",
    "evidence_semantics"
  ],
  "properties": {
    "schema_version": {
      "const": "compact-decision-state-v2"
    },
    "task": {
      "enum": [
        "single",
        "attention",
        "multi_camera"
      ]
    },
    "observation_window_sec": {
      "type": "number",
      "minimum": 0
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "cross_camera": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/cross"
        }
      ]
    },
    "evidence_semantics": {
      "type": "string"
    }
  },
  "$defs": {
    "cam": {
      "enum": [
        "CAM_01",
        "CAM_02",
        "CAM_03"
      ]
    },
    "ref": {
      "type": "string",
      "pattern": "^T[0-9]+$"
    },
    "num": {
      "type": [
        "number",
        "null"
      ]
    },
    "nnum": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "p01": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "posture": {
      "enum": [
        "standing",
        "crouched",
        "low_posture",
        "horizontal",
        "unknown",
        null
      ]
    },
    "limited": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reliability",
        "note"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "reliability": {
          "const": "limited"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "valued": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reliability",
        "note"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "reliability": {
          "enum": [
            "limited",
            "normal"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "observation_window_sec",
        "sampling",
        "quality",
        "people",
        "tracks",
        "interactions",
        "scene",
        "selection_coverage"
      ],
      "properties": {
        "camera": {
          "$ref": "#/$defs/cam"
        },
        "observation_window_sec": {
          "$ref": "#/$defs/nnum"
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame_count",
            "median_interval_sec",
            "max_interval_sec",
            "timestamps_sec"
          ],
          "properties": {
            "frame_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "median_interval_sec": {
              "$ref": "#/$defs/nnum"
            },
            "max_interval_sec": {
              "$ref": "#/$defs/nnum"
            },
            "timestamps_sec": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "number",
                "minimum": 0
              },
              "description": "Canonical sample 시각 배열. run index를 이 배열에 대응; clip-relative seconds."
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cv_reliability",
            "cv_reliability_label",
            "pose_visibility",
            "track_fragmentation",
            "occlusion_proxy",
            "detection_dropout_rate",
            "small_person_fraction",
            "dark_frame_fraction",
            "aggregate_inputs_complete",
            "mean_brightness",
            "mean_contrast",
            "mean_sharpness"
          ],
          "properties": {
            "cv_reliability": {
              "$ref": "#/$defs/p01"
            },
            "cv_reliability_label": {
              "enum": [
                "high",
                "medium",
                "low",
                "unknown"
              ]
            },
            "pose_visibility": {
              "$ref": "#/$defs/p01"
            },
            "track_fragmentation": {
              "$ref": "#/$defs/p01"
            },
            "occlusion_proxy": {
              "$ref": "#/$defs/p01"
            },
            "detection_dropout_rate": {
              "$ref": "#/$defs/p01"
            },
            "small_person_fraction": {
              "$ref": "#/$defs/p01"
            },
            "dark_frame_fraction": {
              "$ref": "#/$defs/p01"
            },
            "aggregate_inputs_complete": {
              "type": "boolean",
              "description": "종합 CV 신뢰도 구성 요소의 이용 가능 여부; high confidence라는 뜻 아님.",
              "x-canonical-source": "quality.pose_visibility,detection_dropout_rate,track_fragmentation,occlusion_proxy,small_person_fraction,dark_frame_fraction",
              "x-units": "boolean",
              "x-summary": "6개 값 모두 non-null이면 true; false이면 cv_reliability=null 및 label=unknown"
            },
            "mean_brightness": {
              "$ref": "#/$defs/nnum",
              "description": "평균 영상 밝기.",
              "x-canonical-source": "quality.mean_brightness",
              "x-units": "pixel intensity 0..255",
              "x-summary": "직접 전달"
            },
            "mean_contrast": {
              "$ref": "#/$defs/nnum",
              "description": "평균 영상 grayscale 표준편차.",
              "x-canonical-source": "quality.mean_contrast",
              "x-units": "pixel intensity standard deviation",
              "x-summary": "직접 전달"
            },
            "mean_sharpness": {
              "$ref": "#/$defs/nnum",
              "description": "평균 Laplacian variance; 카메라별 검증이 필요한 proxy.",
              "x-canonical-source": "quality.mean_sharpness",
              "x-units": "pixel intensity squared",
              "x-summary": "직접 전달"
            }
          }
        },
        "people": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count_min",
            "count_max",
            "count_median",
            "frames_with_person_fraction",
            "tracks_total",
            "tracks_included"
          ],
          "properties": {
            "count_min": {
              "type": "integer",
              "minimum": 0
            },
            "count_max": {
              "type": "integer",
              "minimum": 0
            },
            "count_median": {
              "type": "number",
              "minimum": 0
            },
            "frames_with_person_fraction": {
              "$ref": "#/$defs/p01"
