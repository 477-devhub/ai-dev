    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_ref",
        "reliability",
        "reliability_label",
        "observed_frames",
        "ambiguous_links",
        "first_seen_sec",
        "last_seen_sec",
        "initial_posture",
        "posture_distribution",
        "strongest_vertical_transition",
        "motion",
        "appearance",
        "coverage",
        "temporal",
        "mean_detection_confidence",
        "association_confidence",
        "fragment_link_candidates"
      ],
      "properties": {
        "track_ref": {
          "$ref": "#/$defs/ref"
        },
        "reliability": {
          "$ref": "#/$defs/p01"
        },
        "reliability_label": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "observed_frames": {
          "type": "integer",
          "minimum": 1
        },
        "ambiguous_links": {
          "type": "integer",
          "minimum": 0
        },
        "first_seen_sec": {
          "type": "number",
          "minimum": 0
        },
        "last_seen_sec": {
          "type": "number",
          "minimum": 0
        },
        "initial_posture": {
          "$ref": "#/$defs/posture"
        },
