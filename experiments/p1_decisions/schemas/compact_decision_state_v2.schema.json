                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "enum": [
                      "standing",
                      "crouched",
                      "low_posture",
                      "horizontal",
                      "unknown"
                    ]
                  },
                  {
                    "$ref": "#/$defs/p01"
