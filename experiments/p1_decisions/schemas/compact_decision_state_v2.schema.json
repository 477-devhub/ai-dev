          "type": "object",
          "additionalProperties": false,
          "required": [
            "standing",
            "crouched",
            "low_posture",
            "horizontal",
            "unknown"
          ],
          "properties": {
            "standing": {
              "$ref": "#/$defs/p01"
            },
            "crouched": {
              "$ref": "#/$defs/p01"
            },
            "low_posture": {
              "$ref": "#/$defs/p01"
            },
            "horizontal": {
              "$ref": "#/$defs/p01"
            },
            "unknown": {
              "$ref": "#/$defs/p01"
            }
          }
        },
        "strongest_vertical_transition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed"
          ],
          "properties": {
            "observed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "from": {
              "$ref": "#/$defs/posture"
            },
            "to": {
              "$ref": "#/$defs/posture"
            },
            "start_sec": {
              "$ref": "#/$defs/nnum"
            },
            "end_sec": {
              "$ref": "#/$defs/nnum"
            },
            "duration_sec": {
              "$ref": "#/$defs/nnum"
            },
            "downward_change_bh": {
              "$ref": "#/$defs/valued"
            },
            "confidence": {
              "$ref": "#/$defs/p01"
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mean_speed_bh_per_sec",
            "max_speed_bh_per_sec",
            "net_displacement_fh",
            "direction_change_count",
            "stationary_fraction",
            "low_motion_fraction",
            "longest_low_motion_interval_sec",
            "large_spatial_transition"
          ],
          "properties": {
            "mean_speed_bh_per_sec": {
              "$ref": "#/$defs/nnum"
            },
            "max_speed_bh_per_sec": {
              "$ref": "#/$defs/nnum"
            },
            "net_displacement_fh": {
              "$ref": "#/$defs/nnum"
            },
            "direction_change_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "stationary_fraction": {
              "$ref": "#/$defs/p01"
            },
            "low_motion_fraction": {
              "$ref": "#/$defs/p01"
            },
            "longest_low_motion_interval_sec": {
              "$ref": "#/$defs/nnum"
            },
            "large_spatial_transition": {
              "type": "boolean"
            }
          }
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry",
            "exit",
            "entered_frame",
            "exited_frame"
          ],
          "properties": {
            "entry": {
              "enum": [
                "present_at_clip_start",
                "edge_entry",
                "appears_mid_frame",
                null
              ]
            },
            "exit": {
              "enum": [
                "present_at_clip_end",
                "edge_exit",
                "disappears_mid_frame",
                null
              ]
            },
            "entered_frame": {
              "type": "boolean"
            },
            "exited_frame": {
              "type": "boolean"
            }
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage",
          "description": "전체 Clip/Track span의 관측 coverage.",
          "x-canonical-source": "tracks.observations",
          "x-units": "object",
          "x-summary": "coverage 정의 참조"
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
