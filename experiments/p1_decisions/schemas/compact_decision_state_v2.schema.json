            "tracks_total": {
              "type": "integer",
              "minimum": 0
            },
            "tracks_included": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          }
        },
        "tracks": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "interactions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/interaction"
          }
        },
        "scene": {
          "$ref": "#/$defs/scene"
        },
