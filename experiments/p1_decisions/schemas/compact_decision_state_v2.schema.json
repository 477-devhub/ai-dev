              "x-units": "tuple array",
              "x-summary": "자세 변화 또는 빠진 sample마다 분리; confidence 일부 null이면 min null; bases 정렬 고유값"
            },
            "low_observed_samples": {
              "type": "integer",
              "minimum": 0,
              "description": "crouched/low_posture/horizontal 관측 수.",
              "x-canonical-source": "frames.detections.posture.label",
              "x-units": "samples",
              "x-summary": "LOW 집합 label 개수"
