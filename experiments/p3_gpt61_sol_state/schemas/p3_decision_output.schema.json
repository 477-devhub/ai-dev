{
  "$comment": "P3 Structured Outputs schema templates (strict). prompt_builder.output_schema(task, cameras) selects a template and fills camera enums/properties from the supplied state. Category values = frozen P1/P2 taxonomy. All numbers are model-generated estimates in [0,1].",
  "assessment": {
    "type": "object",
    "additionalProperties": false,
    "required": ["incident", "incident_category", "severity", "imminence", "exposure", "persistence", "human_review"],
    "properties": {
      "incident": {"type": "object", "additionalProperties": false, "required": ["probability"],
                   "properties": {"probability": {"type": "number", "minimum": 0, "maximum": 1}}},
      "incident_category": {"type": "object", "additionalProperties": false, "required": ["value", "confidence"],
                            "properties": {"value": {"type": "string", "enum": ["no_clear_incident", "possible_fall_or_person_down", "possible_physical_conflict",
                                                                                 "possible_scene_or_boundary_entry", "other_safety_relevant", "uncertain"]},
                                           "confidence": {"type": "number", "minimum": 0, "maximum": 1}}},
      "severity": {"type": "object", "additionalProperties": false, "required": ["score"],
                   "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}},
      "imminence": {"type": "object", "additionalProperties": false, "required": ["score"],
                    "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}},
      "exposure": {"type": "object", "additionalProperties": false, "required": ["score"],
                   "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}},
      "persistence": {"type": "object", "additionalProperties": false, "required": ["score"],
                      "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}},
      "human_review": {"type": "object", "additionalProperties": false, "required": ["probability"],
                       "properties": {"probability": {"type": "number", "minimum": 0, "maximum": 1}}}
    }
  },
  "attention_first": {
    "type": "object", "additionalProperties": false, "required": ["camera", "confidence"],
    "properties": {"camera": {"type": "string", "enum": ["__CAMERAS__", "no_clear_priority"]},
                   "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
  },
  "multi_camera_extra": {
    "same_incident": {"type": "object", "additionalProperties": false, "required": ["probability"],
                      "properties": {"probability": {"type": "number", "minimum": 0, "maximum": 1}}},
    "second_view_adds": {"type": "object", "additionalProperties": false, "required": ["probability"],
                         "properties": {"probability": {"type": "number", "minimum": 0, "maximum": 1}}},
    "multiview_value": {"type": "object", "additionalProperties": false, "required": ["score"],
                        "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}}
  }
}
